diff --git a/recipes/authors.js b/recipes/authors.js
new file mode 100644
index 0000000000000000000000000000000000000000..9b0914b9712702c9e5ec417a63549e86685d4146
--- /dev/null
+++ b/recipes/authors.js
@@ -0,0 +1,134 @@
+import { getUsers } from '../users/api.js?v=20261016-sorting1';
+import { fullName, httpUrl, roleLabels } from '../users/model.js?v=20261016-sorting1';
+import { createRecipeFilters, selectRecipes, difficultyLabels, categoryLabels, recipeRating } from './filters.js?v=20261016-sorting1';
+
+let authorsPromise;
+export function loadAuthors() {
+  if (!authorsPromise) authorsPromise = getUsers().catch(error => { authorsPromise = null; throw error; });
+  return authorsPromise;
+}
+export function element(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+export function userCard(user) {
+  const card = element('span', 'author-card');
+  const avatar = element('span', 'author-avatar', ((user.firstName || '')[0] || '?') + ((user.lastName || '')[0] || ''));
+  avatar.setAttribute('aria-hidden', 'true');
+  if (httpUrl(user.image)) {
+    const image = element('img'); image.alt = ''; image.loading = 'lazy';
+    image.addEventListener('error', () => image.remove(), { once: true }); image.src = user.image; avatar.append(image);
+  }
+  const info = element('span', 'author-info');
+  info.append(element('span', 'author-name', fullName(user)));
+  if (user.username) info.append(element('span', 'author-handle', '@' + user.username));
+  card.append(avatar, info); return card;
+}
+
+export function createAuthorProfiles({ getRecipes, openRecipe }) {
+  let dialog, content, opener, restoreFocus = true;
+  function ensureDialog() {
+    if (dialog) return;
+    dialog = element('dialog', 'recipe-dialog recipe-author-dialog');
+    dialog.id = 'recipe-author-dialog'; dialog.setAttribute('aria-labelledby', 'author-profile-title');
+    const close = element('button', 'recipe-dialog-close author-close', '×'); close.type = 'button';
+    close.setAttribute('aria-label', 'Закрыть профиль автора'); close.addEventListener('click', () => dialog.close());
+    content = element('div');
+    const footer = element('div', 'author-footer');
+    const back = element('button', 'recipe-secondary', '← Вернуться к рецепту'); back.type = 'button';
+    back.addEventListener('click', () => dialog.close()); footer.append(back);
+    dialog.append(close, content, footer); document.body.append(dialog);
+    dialog.addEventListener('close', () => {
+      document.body.classList.toggle('recipe-modal-open', !!document.querySelector('.recipe-dialog[open]'));
+      if (restoreFocus && opener?.isConnected) opener.focus({ preventScroll: true });
+      restoreFocus = true;
+    });
+    document.getElementById('recipe-details').addEventListener('close', () => { if (dialog.open) dialog.close(); });
+    window.addEventListener('hashchange', () => { if (dialog.open) dialog.close(); });
+  }
+  function open(user, source) {
+    ensureDialog(); opener = source;
+    content.replaceChildren();
+    const layout = element('div', 'author-profile-layout');
+    const data = element('section', 'author-profile-data'); data.setAttribute('aria-label', 'Информация о пользователе');
+    const title = element('h2', '', fullName(user)); title.id = 'author-profile-title'; title.tabIndex = -1;
+    data.append(element('p', 'eyebrow', 'Профиль автора'), title, userCard(user));
+    const fields = element('dl', 'author-profile-fields');
+    for (const [label, value] of [
+      ['ID', user.id === 0 ? 'Локальный профиль' : user.id],
+      ['Имя', fullName(user)], ['Ник', user.username ? '@' + user.username : 'Не указан'],
+      ['Роль', user.id === 0 ? 'Автор на этой странице' : roleLabels[user.role] || 'Не указана'],
+      ['Почта', user.email || 'Не указана'], ['Телефон', user.phone || 'Не указан']
+    ]) {
+      const row = element('div', 'author-profile-field');
+      row.append(element('dt', '', label), element('dd', '', String(value))); fields.append(row);
+    }
+    data.append(fields);
+    if (user.description) data.append(element('p', 'author-description', user.description));
+    const section = element('section', 'author-recipes');
+    const heading = element('h3', '', 'Рецепты автора');
+    const filtersBox = element('div');
+    const count = element('p', 'recipe-results'); count.setAttribute('role', 'status');
+    const list = element('div', 'author-recipe-list');
+    section.setAttribute('aria-label', 'Блюда и категории автора');
+    section.append(element('p', 'eyebrow', 'Блюда автора'), heading, filtersBox, count, list);
+    layout.append(section, data); content.append(layout);
+    const recipes = selectRecipes(getRecipes(), {}, user.id);
+    const filters = createRecipeFilters(filtersBox, 'author', render, { categories: true });
+    filters.update(recipes);
+    function render() {
+      const visible = selectRecipes(recipes, filters.values());
+      count.textContent = 'Показано: ' + visible.length + ' из ' + recipes.length;
+      list.replaceChildren();
+      if (!visible.length) {
+        list.append(element('p', 'recipe-empty', recipes.length ? 'Ничего не найдено. Измените фильтр или нажмите «Сбросить».' : 'В каталоге пока нет рецептов этого автора.'));
+      }
+      for (const recipe of visible) {
+        const button = element('button', 'author-recipe'); button.type = 'button';
+        button.setAttribute('aria-label', 'Открыть рецепт: ' + recipe.name);
+        if (recipe.image) {
+          const image = element('img'); image.src = recipe.image; image.alt = ''; image.loading = 'lazy';
+          image.addEventListener('error', () => image.remove(), { once: true }); button.append(image);
+        }
+        const info = element('span', 'author-recipe-info');
+        info.append(element('strong', '', recipe.name));
+        const time = (Number(recipe.prepTimeMinutes) || 0) + (Number(recipe.cookTimeMinutes) || 0);
+        const rating = recipeRating(recipe);
+        info.append(element('span', '', [recipe.cuisine, difficultyLabels[recipe.difficulty] || recipe.difficulty, time + ' мин.', rating === null ? '' : '★ ' + rating].filter(Boolean).join(' · ')));
+        if (recipe.mealType?.length) info.append(element('span', 'author-recipe-category', recipe.mealType.map(value => categoryLabels[value] || value).join(' · ')));
+        button.append(info, element('span', 'author-recipe-arrow', '↗'));
+        button.addEventListener('click', () => { restoreFocus = false; dialog.close(); openRecipe(recipe.id); });
+        list.append(button);
+      }
+    }
+    render();
+    if (!dialog.open) dialog.showModal();
+    document.body.classList.add('recipe-modal-open'); dialog.scrollTop = 0; title.focus({ preventScroll: true });
+  }
+  async function mount(container, recipe) {
+    if (recipe.userId == null) { container.replaceChildren(element('p', 'reviews-note', 'Автор рецепта не указан.')); return; }
+    container.replaceChildren(element('p', 'reviews-note', 'Загружаем автора рецепта…'));
+    try {
+      const user = Number(recipe.userId) === 0
+        ? { id: 0, firstName: 'Вы', lastName: '', username: '', description: 'Рецепты, добавленные вами на этой странице.' }
+        : (await loadAuthors()).find(item => item.id === Number(recipe.userId));
+      if (!container.isConnected) return;
+      if (!user) throw new Error('Автор рецепта не найден.');
+      const button = element('button', 'recipe-owner'); button.type = 'button';
+      button.setAttribute('aria-haspopup', 'dialog'); button.setAttribute('aria-controls', 'recipe-author-dialog');
+      button.setAttribute('aria-label', 'Открыть профиль автора рецепта: ' + fullName(user));
+      const info = element('span', 'recipe-owner-info');
+      info.append(element('span', 'recipe-owner-label', 'Автор рецепта'), userCard(user));
+      button.append(info, element('span', 'recipe-owner-link', 'Все рецепты автора →'));
+      button.addEventListener('click', () => open(user, button)); container.replaceChildren(button);
+    } catch (error) {
+      if (!container.isConnected) return;
+      const retry = element('button', 'recipe-secondary', 'Повторить загрузку автора'); retry.type = 'button';
+      retry.addEventListener('click', () => mount(container, recipe));
+      container.replaceChildren(element('p', 'reviews-status', error.message), retry);
+    }
+  }
+  return { mount, open };
+}
