+.recipe-filters{display:grid;grid-template-columns:minmax(170px,1.5fr) minmax(110px,1fr) minmax(110px,1fr) minmax(190px,1.3fr) auto;gap:14px;align-items:end;padding:20px;border:1px solid var(--line);border-radius:14px;background:var(--surface);margin:25px 0 12px}
+.recipe-filters label{display:grid;gap:7px;font-size:13px;color:var(--secondary);min-width:0}
+.recipe-filters input,.recipe-filters select{width:100%;min-width:0;padding:12px;border:1px solid var(--demo-border);border-radius:8px;background:var(--bg);color:var(--text);font:inherit;min-height:44px}
+.recipe-filters button{min-height:44px}
+.recipe-results{color:var(--muted);font-size:14px;margin:12px 0}
+.recipe-empty{grid-column:1/-1;padding:24px;border:1px dashed var(--line);border-radius:12px;color:var(--muted)}
+.recipe-owner{display:flex;width:100%;align-items:center;justify-content:space-between;gap:16px;text-align:left;background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:12px;padding:16px 20px;margin:0 0 22px}
+.recipe-owner:hover,.author-recipe:hover{border-color:var(--lime)}
+.recipe-owner-label{display:block;color:var(--muted);font-size:12px;margin-bottom:9px}
+.recipe-owner-link{color:var(--lime);font-size:13px}
+.author-card{display:flex;gap:12px;align-items:center;min-width:0}
+.author-avatar{display:grid;place-items:center;position:relative;overflow:hidden;flex:none;width:48px;height:48px;border-radius:12px;background:var(--highlight-bg);color:var(--lime);font-size:18px;font-weight:700}
+.author-avatar img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
+.author-info{display:grid;gap:3px;min-width:0}
+.author-name{font-size:16px;font-weight:700;overflow-wrap:anywhere}
+.author-handle{font-size:12px;color:var(--muted);overflow-wrap:anywhere}
+.recipe-author-dialog{max-width:1000px;padding:0}
+.recipe-author-dialog .author-close{position:absolute;right:20px;top:20px}
+.author-profile-layout{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);align-items:stretch;min-height:500px}
+.author-profile-data{padding:64px 28px 30px;background:var(--bg);border-left:1px solid var(--line);min-width:0}
+.author-profile-data h2{font-size:28px;margin:0 0 22px;overflow-wrap:anywhere}
+.author-profile-data .author-card{border:1px solid var(--line);background:var(--surface);padding:18px;border-radius:12px;margin-bottom:20px}
+.author-profile-data .author-avatar{width:64px;height:64px;font-size:23px}
+.author-profile-fields{margin:0}
+.author-profile-field{display:grid;grid-template-columns:70px minmax(0,1fr);gap:14px;padding:12px 0;border-bottom:1px solid var(--line);font-size:14px}
+.author-profile-field dt{color:var(--muted)}
+.author-profile-field dd{margin:0;overflow-wrap:anywhere}
+.author-description{font-size:13px;color:var(--muted);margin:20px 0 0;line-height:1.7;overflow-wrap:anywhere}
+.author-recipes{padding:32px 28px;min-width:0}
+.author-recipes h3{margin:0;font-size:25px}
+.author-recipes .recipe-filters{grid-template-columns:minmax(0,1fr) auto;padding:0;border:0;margin-top:24px}
+.author-recipes .recipe-filters label:first-child{grid-column:1/-1}
+.author-recipes .recipe-filters .recipe-filter-category{grid-column:1/-1}
+.author-recipes .recipe-filters button{grid-column:auto}
+.author-recipe-list{display:grid;gap:10px;margin-top:18px}
+.author-recipe{display:flex;align-items:center;gap:14px;width:100%;padding:12px;border:1px solid var(--line);border-radius:12px;background:var(--bg);color:var(--text);text-align:left}
+.author-recipe img{width:72px;height:72px;border-radius:8px;object-fit:cover;flex:none}
+.author-recipe-info{display:grid;gap:7px;min-width:0}
+.author-recipe-info strong{font-size:16px;overflow-wrap:anywhere}
+.author-recipe-info>span{font-size:12px;color:var(--muted)}
+.author-recipe-info .author-recipe-category{color:var(--lime)}
+.author-recipe-arrow{margin-left:auto;color:var(--lime)}
+.author-footer{display:flex;padding:18px 28px;border-top:1px solid var(--line)}
+.recipe-filters :is(input,select,button):focus-visible,.recipe-owner:focus-visible,.author-recipe:focus-visible,.recipe-review-author:focus-visible{outline:3px solid var(--lime);outline-offset:3px}
+@media(max-width:1000px){
+  .recipe-filters{grid-template-columns:1fr 1fr}.recipe-filters label:first-child{grid-column:1/-1}.recipe-filters button{grid-column:1/-1}
+  #recipe-filter-controls .recipe-filter-sort{grid-column:1/-1}
+}
+@media(max-width:700px){
+  .recipe-owner{align-items:flex-start;flex-direction:column;padding:16px}
+  .author-footer{padding:18px 20px}.author-recipe{gap:12px}.author-recipe img{width:62px;height:62px}
+}
+@media(min-width:521px) and (max-width:800px){
+  .author-profile-layout{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
+  .author-recipes{padding:26px 16px}.author-profile-data{padding:60px 16px 26px}
+  .author-recipes h3,.author-profile-data h2{font-size:22px}
+  .author-profile-data .author-card{padding:12px;gap:9px}.author-profile-data .author-avatar{width:42px;height:42px;font-size:18px}
+  .author-profile-data .author-name{font-size:14px}.author-profile-field{grid-template-columns:52px minmax(0,1fr);gap:8px;font-size:12px}
+  .author-recipes .recipe-filters{gap:10px}.author-recipes .recipe-filters input,.author-recipes .recipe-filters select{padding:10px 8px}
+  .author-recipes .recipe-filters button{padding:9px 8px;font-size:12px}
+  .author-recipe{padding:10px;gap:9px}.author-recipe img{width:50px;height:58px}.author-recipe-info strong{font-size:14px}
+}
+@media(max-width:520px){
+  .author-profile-layout{grid-template-columns:1fr}
+  .author-profile-data{order:-1;border-left:0;border-bottom:1px solid var(--line);padding:60px 20px 26px}
+  .author-profile-data h2{font-size:26px}.author-recipes{padding:24px 20px}.author-recipes h3{font-size:23px}
+}
